# Copy to configs/providers/<provider-id>.yml and edit the public metadata.
# Do not put a literal API key in this tracked example. The recommended path is
# to enter the connection URL and key in the Web UI Settings page.

label: Example OpenAI-compatible provider
provider: openai-compatible
backend: openai-compatible
model_name: example-model
model_names:
  - example-model
  - example-fast-model

# Optional legacy environment-variable fallbacks:
# api_key_env: EXAMPLE_LLM_API_KEY
# base_url_env: EXAMPLE_LLM_BASE_URL
# models_url_env: EXAMPLE_LLM_MODELS_URL
