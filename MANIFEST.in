# Start from an explicit allowlist, including when building from a dirty checkout.
global-exclude *
include pyproject.toml MANIFEST.in LICENSE README.md README.zh-CN.md
include docs/web-application.md
recursive-include video_translate *.py
# Local persistence work must never enter this release.
exclude video_translate/storage.py video_translate/storage_migration.py
global-exclude *.pyc *.pyo
prune configs
prune tests
prune outputs
prune YoutubeDownloads
prune frontend
prune .github
