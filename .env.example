# Legacy compatibility template only. New installs should manage provider keys
# from the Web UI Settings page (stored in configs/provider_secrets.yaml) and
# copy configs/local_runtime.example.yaml to configs/local_runtime.yaml for
# machine-local runtime settings. Never commit a real .env file.

# ---------------------------------------------------------------------------
# Generic OpenAI-compatible LLM settings
# ---------------------------------------------------------------------------
# Copy configs/llm.example.yaml to configs/llm.yaml, then edit:
#   defaults.base_url
#   defaults.models.*
#
# Example base URL/model values in configs/llm.example.yaml use Volcengine
# Ark / Doubao. Other OpenAI-compatible providers can be used by replacing the
# URL, model names, and API key below.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Provider profiles under configs/providers may reference these names. These
# variables are optional legacy aliases. The Web UI Settings page stores
# write-only keys and URLs in the Git-ignored configs/provider_secrets.yaml.
ARK_API_KEY=
QIANWEN_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=

# Long subtitle batches and glossary extraction may take several minutes.
LLM_REQUEST_TIMEOUT=240
LLM_REQUEST_RETRIES=3

# Optional per-task override. Leave empty to use configs/llm.yaml model_role.
ASR_CORRECTION_MODEL=

# ---------------------------------------------------------------------------
# YouTube download settings
# ---------------------------------------------------------------------------
# Empty means no proxy. If your network needs a local proxy, set for example:
# YTDLP_PROXY=http://127.0.0.1:7890
YTDLP_PROXY=

# Relative paths are resolved from the project root.
YTDLP_OUTPUT_DIR=YoutubeDownloads
YTDLP_SUB_LANGS=ko,en.*,ja,zh-Hans,zh-Hant

# ---------------------------------------------------------------------------
# Web UI / Agent settings
# ---------------------------------------------------------------------------
# Safe default. Use 0.0.0.0 only on a trusted network; the UI has no login.
VIDEO_TRANSLATE_HOST=127.0.0.1
VIDEO_TRANSLATE_PORT=7860
VIDEO_TRANSLATE_DOWNLOAD_DIR=YoutubeDownloads

# Model/cache directory used by PaddleOCR and faster-whisper.
VIDEO_TRANSLATE_CACHE_DIR=models

# Global OCR device default used when config/CLI passes device=auto.
# Use gpu:0 on a single-GPU Windows machine, cpu to force CPU, or leave auto.
VIDEO_TRANSLATE_OCR_DEVICE=auto

# Optional: set these yourself only if you need custom cache locations.
# HF_HOME=models/huggingface
# PADDLE_HOME=models/paddle
# PADDLE_PDX_CACHE_HOME=models/paddlex

# ---------------------------------------------------------------------------
# CUDA / local runtime
# ---------------------------------------------------------------------------
# Normally you do not need to set LD_LIBRARY_PATH manually. The project tries
# to prepend CUDA library paths from installed nvidia-* Python packages for ASR.
# LD_LIBRARY_PATH=
