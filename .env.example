# Copy this file to .env and edit values for your machine.
# Never commit .env. It may contain API keys.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# This template uses Volcengine Ark as an OpenAI-compatible example.
# For another provider, keep these LLM_* names and replace the key/base URL/model.
#
# Global default model. Task-specific models in configs/llm.yaml override this.
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_MODEL=doubao-seed-2.0-pro

# Long subtitle batches and glossary extraction may take several minutes.
LLM_REQUEST_TIMEOUT=240
LLM_REQUEST_RETRIES=3

# Optional per-task override. Leave empty to use configs/llm.yaml.
ASR_CORRECTION_MODEL=

# ---------------------------------------------------------------------------
# YouTube download settings
# ---------------------------------------------------------------------------
# Empty means no proxy. If your network needs a local proxy, set for example:
# YTDLP_PROXY=http://127.0.0.1:7890
YTDLP_PROXY=

# Relative paths are resolved from the project root.
YTDLP_OUTPUT_DIR=YoutubeDownloads
YTDLP_SUB_LANGS=ko,en.*,ja,zh-Hans,zh-Hant

# ---------------------------------------------------------------------------
# Web UI / Agent settings
# ---------------------------------------------------------------------------
VIDEO_TRANSLATE_HOST=0.0.0.0
VIDEO_TRANSLATE_PORT=7860
VIDEO_TRANSLATE_DOWNLOAD_DIR=YoutubeDownloads

# Model/cache directory used by PaddleOCR and faster-whisper.
VIDEO_TRANSLATE_CACHE_DIR=models

# Global OCR device default used when config/CLI passes device=auto.
# Use gpu:0 on a single-GPU Windows machine, cpu to force CPU, or leave auto.
VIDEO_TRANSLATE_OCR_DEVICE=auto

# Optional: set these yourself only if you need custom cache locations.
# HF_HOME=models/huggingface
# PADDLE_HOME=models/paddle
# PADDLE_PDX_CACHE_HOME=models/paddlex

# ---------------------------------------------------------------------------
# CUDA / local runtime
# ---------------------------------------------------------------------------
# Normally you do not need to set LD_LIBRARY_PATH manually. The project tries
# to prepend CUDA library paths from installed nvidia-* Python packages for ASR.
# LD_LIBRARY_PATH=
